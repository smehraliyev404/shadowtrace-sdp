# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# Database name is required in every mode.
MONGO_DATABASE=shadowtrace

# ---- Option A: shared team cluster (MongoDB Atlas, recommended) ----
# Get this from Atlas -> Database -> Connect -> Drivers, after creating a
# database user. Leave commented out to use local mode instead.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ---- Option B: local single-node Mongo via docker-compose ----
# Only used if MONGO_URI above is not set.
MONGO_USERNAME=shadowtrace_admin
MONGO_PASSWORD=change_me
MONGO_HOST=localhost:27017
