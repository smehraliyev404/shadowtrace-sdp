*.exe
collector/traces.json
.idea/

# virtualenvs - don't commit these
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# python cache / compiled stuff
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache/
.coverage

# jupyter checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# macOS junk
.DS_Store
.AppleDouble
.LSOverride
._*

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*.iml

# the trace dumps are huge, keep them out of git.
# using ** here on purpose - data/raw_traces/*.json wouldn't catch the per-run
# subfolders since a single * won't cross a /, and the harvester makes one
# folder per run.
data/raw_traces/**
data/processed/**
data/runs/**
data/*.json
data/*.csv
!data/.gitkeep
!data/raw_traces/.gitkeep
!data/processed/.gitkeep
!data/runs/.gitkeep

# secrets - never commit real credentials
.env
